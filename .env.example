# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，绝不入库。
# ---- RunningHub LLM ----
RUNNINGHUB_API_KEY=sk-xxxx
RUNNINGHUB_BASE_URL=https://llm.runninghub.cn/v1
RUNNINGHUB_MODEL=deepseek/deepseek-v4.1-flash
# 关闭思考模式。界面上叫 off，但线上参数值必须是 none（传 off 会 400）。
# 留空 = 不带该参数 = 模型默认 = 开启思考，所以这行不要删。
RUNNINGHUB_REASONING_EFFORT=none
# 备用带 webSearch 的模型（新闻面），同 key
RUNNINGHUB_NEWS_MODEL=qwen/qwen3.8-max

# ---- Mobius SMC 信号源 ----
# 可选。不填也能用（匿名 10 req/min per IP）。
# 填了升到 60 req/min —— 必须写成 Authorization: Bearer（代码已自动带）。
# ⚠️ token 放在 X-API-Key 之类的自定义头不会报错，但档位静默停留在 10/min。
MOBIUSQUANT_API_TOKEN=

# ---- MT5 ----
MT5_TERMINAL_PATH=D:\MT5\terminal64.exe
# 单品种时用这个（也是未设 TRADE_SYMBOLS 时的默认品种）
MT5_SYMBOL=XAUUSDm
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ---- 多品种（可选）----
# 留空/删除 = 只交易 MT5_SYMBOL（默认，即现有黄金单品种行为）。
# 填逗号分隔的品种名 = 单进程并发交易全部品种。
# 已注册品种：XAUUSDm BTCUSDm USOILm EURUSDm USDJPYm
# （见 src/gold_agent/common/symbols.py 的 PROFILES；未注册会启动即报错）
# ⚠️ 多品种下状态按品种隔离到 data/<品种>/，日志每条带 symbol 标签，
#    LLM 每小时预算按品种数平分（参见 config.toml 的 [llm] 与 [risk]）。
# 建议先逐个加（先只放 BTCUSDm 跑通，再加下一个），不要一次全开。
# TRADE_SYMBOLS=XAUUSDm,BTCUSDm

# ---- 运行模式 ----
# dry_run: 不真实下单；live: 真实下单
TRADE_MODE=live
MAX_LOT=0.06
